// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id                      Int       @id @default(autoincrement())
  email                   String    @unique
  name                    String
  password                String?
  profilePicture          String?
  otp                     String?
  otpExpiry               DateTime?
  forgotPasswordOtp       String?
  forgotPasswordOtpExpiry DateTime?
  refreshToken            String?
  role                    String    @default("USER")
  googleId                String?   @unique
  facebookId              String?   @unique
  isVerified              Boolean   @default(false)
  createdAt               DateTime  @default(now())
  updatedAt               DateTime  @updatedAt
}

model Hotel {
  id          Int      @id @default(autoincrement())
  name        String
  description String
  city        String
  country     String
  address     String
  latitude    Float?
  longitude   Float?
  starRating  Int?
  images      String[]
  amenities   String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  rooms Room[]
}

model Room {
  id             Int      @id @default(autoincrement())
  hotelId        Int
  name           String
  description    String?
  type           String
  bedType        String
  pricePerNight  Float
  availableRooms Int
  totalRooms     Int
  size           Int?
  view           String?
  images         String[]
  amenities      String[]
  isActive       Boolean  @default(true)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  hotel Hotel @relation(fields: [hotelId], references: [id])
  // hotelBookings HotelBooking[]
}

model CarRental {
  id          Int      @id @default(autoincrement())
  company     String
  model       String
  type        String
  city        String
  pricePerDay Float
  available   Boolean  @default(true)
  features    String[]
  images      String[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  // carRentalBookings CarRentalBooking[]
}

model TourPackage {
  id             Int      @id @default(autoincrement())
  title          String
  description    String
  destination    String
  price          Float
  durationDays   Int // in days
  maxGroupSize   Int
  availableSlots Int
  images         String[]
  inclusions     String[]
  exclusions     String[]
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  // tourBookings TourBooking[]
}
